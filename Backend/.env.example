PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE
JWT_SECRET=replace-with-a-long-random-secret

FRONTEND_URL=https://3ddiscovery.onrender.com

# Recommended for Render deployments: use an HTTPS email API instead of SMTP.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=3D Discovery <no-reply@your-verified-domain.com>

# Optional SMTP fallback for environments that permit outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=3D Discovery
