# Backend service: 3ddiscovery-api
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=https://3ddiscovery.onrender.com

# Configure with a Resend API key and a sender address verified with Resend.
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=3D Discovery <no-reply@your-verified-domain.com>

# Optional SMTP fallback for environments that permit outbound SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=3D Discovery

# Frontend service: 3ddiscovery
VITE_API_URL=https://3ddiscovery-api.onrender.com
